NEXT_PUBLIC_API_URL=http://localhost:8000

# ZizkaDB — server-side only, never exposed to the browser.
# Create an agent in the ZizkaDB dashboard first; ZIZKADB_AGENT_NAME must match it exactly
# (or match whatever agent your key is scoped to — see below).
# Cloud (https://db.zizka.ai): set ZIZKADB_API_KEY only, leave ZIZKADB_HOST unset.
ZIZKADB_API_KEY=zizkadb_live_xxxx
ZIZKADB_AGENT_NAME=typescript-sdk-chat-agent

# Self-hosted (e.g. http://localhost:8000 for the ZizkaDB docker-compose stack):
# set ZIZKADB_HOST. A self-hosted key ONLY authenticates against the host it was
# created on — if ZIZKADB_HOST is left unset while ZIZKADB_API_KEY is a self-hosted
# key, the client defaults to the cloud host and every request 401s. So for a
# self-hosted key, set BOTH ZIZKADB_HOST and ZIZKADB_API_KEY:
# ZIZKADB_HOST=http://localhost:8000
# ZIZKADB_API_KEY=zizkadb_live_xxxx  (from the self-hosted dashboard, not cloud)
#
# Sanity-check a key/host pair and see which agent(s) it's scoped to:
#   curl -s http://localhost:8000/v1/agents -H "Authorization: Bearer <key>"

# Enables the /api/zizkadb/* debug/inspector routes and the Inspector panel.
# Defaults to enabled outside production; set to "false" to disable anywhere,
# or "true" to force it on in a production build.
# ZIZKADB_INSPECTOR_ENABLED=true
